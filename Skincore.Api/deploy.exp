#!/usr/bin/expect -f
set timeout -1
set password "Furkan2626."

puts "Deploying Admin Panel..."
spawn bash -c "cd /Users/furkanyilmaz/Desktop/skincore && scp -r adminpanel/dist/* root@91.132.49.137:/var/www/adminpanel/"
expect "*?assword:*"
send "$password\r"
expect eof

puts "Deploying Backend SDK..."
spawn bash -c "cd /Users/furkanyilmaz/Desktop/skincore && scp -r Skincore.Api/publish/* root@91.132.49.137:/var/www/skincore-api/"
expect "*?assword:*"
send "$password\r"
expect eof

puts "Restarting backend service..."
spawn bash -c "ssh root@91.132.49.137 'systemctl restart skincore-api'"
expect "*?assword:*"
send "$password\r"
expect eof

puts "Done!"
